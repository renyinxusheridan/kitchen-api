# Copy to .env only for a new setup. Keep your existing working .env.
# Replace placeholders locally. URL-encode special characters in credentials.
MONGODB_URI=mongodb+srv://<database-user>:<url-encoded-password>@<cluster-host>/
# For this project, use kitchen_app.
DB_NAME=<database-name>
# Local server only; use 3000. Netlify Functions do not need PORT.
PORT=<local-port>
